# Copy to .env for local overrides. Never commit .env.
# Empty values below are placeholders. This phase sends no exchange and no LLM requests.

ATS_MODE=paper
ATS_ALLOW_LIVE_TRADING=false
ATS_ALLOW_LEVERAGE=false
ATS_ALLOW_MARGIN=false
ATS_ALLOW_WITHDRAW=false
ATS_QUOTE_CURRENCY=USDC
ATS_REPORT_CURRENCY=USDC
ATS_CONFIG_PATH=configs/paper.example.yaml

# Local prototype. PostgreSQL URL is for Docker Compose, still paper-only.
ATS_DATABASE_URL=sqlite:///./local.db
# ATS_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading

ATS_NEWS_POLL_INTERVAL_SEC=60
ATS_NEWS_STALE_AFTER_SEC=600

# Runtime. simulated = labelled synthetic walk from 100. binance_public = public GET only.
ATS_EXCHANGE=simulated
ATS_RUN_LOOP=false
ATS_RUNTIME=1
ATS_MARKET_POLL_INTERVAL_SEC=5
# Illustrative headlines only, e.g. configs/news.fixtures.example.json. Empty = no news.
ATS_NEWS_FIXTURES_PATH=

# Leave empty. The process must not require these to start, and must not send them to the UI.
ATS_CRYPTOPANIC_TOKEN=
ATS_LLM_API_KEY=
ATS_LLM_BASE_URL=
ATS_EXCHANGE_API_KEY=
ATS_EXCHANGE_API_SECRET=
ATS_EXCHANGE_API_PASSPHRASE=

# Telegram (phase 6) — separate process, read-only. Never commit the token.
# Either prefix works: TELEGRAM_* or ATS_TELEGRAM_*.
# Enabled only when BOTH the token and the allowlist are set.
# Default mode is "process": `python -m app.telegram`. Do not set inprocess while serve is running.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CHAT_ID=
ATS_TELEGRAM_MODE=process
ATS_TELEGRAM_API_BASE_URL=http://127.0.0.1:8000
ATS_TELEGRAM_CONTROLS_ENABLED=false
ATS_TELEGRAM_DIGEST_INTERVAL_SEC=3600
ATS_TELEGRAM_MAX_MESSAGES_PER_MINUTE=10
ATS_TELEGRAM_DRAWDOWN_ALERT_PCT=5
ATS_TELEGRAM_STATE_PATH=var/telegram_state.json

# Render 24/7: docs/RENDER.md and deploy/render/env.example. Do not put tokens in git.
