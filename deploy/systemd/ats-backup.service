[Unit]
Description=ATS SQLite backup and restore verification
After=ats-paper.service

[Service]
Type=oneshot
User=ats
Group=ats
WorkingDirectory=/opt/botbirja
ExecStart=/opt/botbirja/.venv/bin/python -m app.cli backup --config /opt/botbirja/configs/paper.binance_public.usdt.yaml --dest /opt/botbirja/var/backups
