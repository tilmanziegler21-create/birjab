# Values for the Render Dashboard. Do not commit real tokens.
# Blueprint leaves TELEGRAM_* as sync:false so you paste them once.

ATS_MODE=paper
ATS_ALLOW_LIVE_TRADING=false
ATS_ALLOW_LEVERAGE=false
ATS_ALLOW_MARGIN=false
ATS_ALLOW_WITHDRAW=false
ATS_EXCHANGE=binance_public
ATS_QUOTE_CURRENCY=USDT
ATS_REPORT_CURRENCY=USDT
ATS_CONFIG_PATH=configs/paper.binance_public.usdt.yaml
ATS_RUN_LOOP=true
ATS_RUNTIME=1
ATS_TELEGRAM_MODE=process
ATS_TELEGRAM_CONTROLS_ENABLED=false

# Paper private service only:
ATS_ROLE=paper
ATS_REQUIRE_EXISTING_DB=true
PORT=10000
ATS_DATABASE_URL=sqlite:///./var/local.db

# Telegram worker only:
# ATS_ROLE=telegram
# ATS_TELEGRAM_API_BASE_URL is injected from ats-paper (hostport).
# ATS_TELEGRAM_STATE_PATH=var/telegram_state.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CHAT_ID=

# Leave empty. Do not set exchange or LLM keys on Render in this phase.
ATS_EXCHANGE_API_KEY=
ATS_EXCHANGE_API_SECRET=
ATS_EXCHANGE_API_PASSPHRASE=
ATS_LLM_API_KEY=
ATS_CRYPTOPANIC_TOKEN=
